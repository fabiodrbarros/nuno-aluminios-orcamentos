# Porta HTTP interna (predefinição 3100)
PORT=
# Pasta persistente: base de dados (orcamentos.db) e fotografias (predefinição /data)
DATA_DIR=
# Conta de acesso (criada e atualizada a cada arranque)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Segredo para assinar as sessões (texto aleatório longo)
SESSION_SECRET=
# URL público desta aplicação, sem barra final (ex.: https://orcamentos.dominio.pt) — usado nos links enviados aos clientes
PUBLIC_URL=
# Opcional: ponte WhatsApp (WAHA) para envio automático com PDF. Vazio = envio manual (wa.me).
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_SESSION=default
