<%- include('../partials/top') %>
<% const est = calculo.estadoVisivel(orc, hoje);
   const json = (v) => JSON.stringify(v).replace(/</g, '\\u003c');
   const ivaOpts = [23, 13, 6, 0]; %>
<header class="page-head">
  <div>
    <p class="kicker"><a href="/orcamentos"><%- icon('arrowLeft', 'icon--sm') %> Orçamentos</a></p>
    <h1><%= orc.numero %> <span class="estado estado--<%= est %>"><%= calculo.ESTADOS[est] %></span></h1>
  </div>
  <div class="head-actions">
    <a class="a-btn" href="/orcamentos/<%= orc.id %>/pdf" target="_blank" rel="noopener" data-save-first><%- icon('file') %> Ver PDF</a>
    <a class="a-btn a-btn--primary" href="/orcamentos/<%= orc.id %>/enviar" data-save-first><%- icon('send') %> Enviar</a>
  </div>
</header>
<noscript><div class="alert alert--error">O editor precisa de JavaScript ativo.</div></noscript>
<% if (orc.estado !== 'rascunho') { %>
<div class="alert alert--warn">Este orçamento já foi <%= orc.estado === 'aceite' ? 'aceite' : (orc.estado === 'recusado' ? 'recusado' : 'enviado') %>. As alterações ficam visíveis no link do cliente; para uma nova versão, use <strong>Duplicar</strong>.</div>
<% } %>
<form id="orc-form" class="editor" method="post" action="/orcamentos/<%= orc.id %>" data-id="<%= orc.id %>" autocomplete="off">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="editor__main">
    <section class="card">
      <div class="card__head"><h2>Cliente e obra</h2></div>
      <div class="picker" data-cliente-picker data-orc="<%= orc.id %>">
        <input type="hidden" name="cliente_id" value="<%= orc.cliente_id || '' %>">
        <div class="picker__current" data-picker-current>
          <% if (orc.cliente_id) { %>
            <%- icon('users') %><a class="strong" href="/clientes/<%= orc.cliente_id %>"><%= orc.cliente_nome %></a>
          <% } else { %>
            <%- icon('users') %><span class="muted">Sem ficha de cliente</span>
          <% } %>
          <button type="button" class="a-btn a-btn--sm" data-picker-toggle><%= orc.cliente_id ? 'Trocar' : 'Associar cliente' %></button>
        </div>
        <div data-picker-box hidden>
          <span class="search search--field"><%- icon('search') %><input type="search" autocomplete="off" placeholder="Procurar cliente…" data-picker-input></span>
          <ul class="picker__list" data-picker-list hidden></ul>
        </div>
      </div>
      <details class="details" <%= orc.cliente_id ? '' : 'open' %>>
        <summary>Dados do cliente no documento</summary>
        <div class="grid-2">
          <label class="f"><span>Nome</span><input name="cliente_nome" value="<%= orc.cliente_nome %>" maxlength="200"></label>
          <label class="f"><span>NIF</span><input name="cliente_nif" value="<%= orc.cliente_nif %>" maxlength="40"></label>
          <label class="f"><span>Telefone</span><input name="cliente_telefone" value="<%= orc.cliente_telefone %>" maxlength="60"></label>
          <label class="f"><span>Email</span><input name="cliente_email" value="<%= orc.cliente_email %>" maxlength="200"></label>
        </div>
        <label class="f"><span>Morada</span><input name="cliente_morada" value="<%= orc.cliente_morada %>" maxlength="400"></label>
      </details>
      <div class="grid-2">
        <label class="f"><span>Assunto</span><input name="titulo" value="<%= orc.titulo %>" maxlength="200" placeholder="Ex.: Substituição de caixilharia"></label>
        <label class="f"><span>Local da obra</span><input name="obra_local" value="<%= orc.obra_local %>" maxlength="300"></label>
        <label class="f"><span>Data</span><input type="date" name="data" value="<%= orc.data %>"></label>
        <label class="f"><span>Validade <small>(dias)</small></span><input type="number" name="validade_dias" value="<%= orc.validade_dias %>" min="1" max="365"></label>
      </div>
    </section>

    <section class="card">
      <div class="card__head"><h2>Trabalhos</h2><span class="small muted" data-count></span></div>
      <div class="lines" data-lines></div>
      <div class="adder">
        <label class="adder__pick">
          <span class="sr-only">Artigo</span>
          <select data-add-artigo>
            <option value="">Adicionar do catálogo…</option>
            <% const cats = { janela: 'Janelas', porta: 'Portas', envidracado: 'Envidraçados', acessorio: 'Estores e acessórios', servico: 'Serviços' };
               Object.entries(cats).forEach(([k, nome]) => { const items = artigos.filter((a) => a.categoria === k); if (!items.length) return; %>
            <optgroup label="<%= nome %>"><% items.forEach((a) => { %><option value="<%= a.id %>"><%= a.nome %></option><% }) %></optgroup>
            <% }) %>
          </select>
        </label>
        <button type="button" class="a-btn a-btn--sm" data-add="vao"><%- brandIcon('janela', 'icon') %> Vão livre</button>
        <button type="button" class="a-btn a-btn--sm" data-add="artigo"><%- icon('plus') %> Linha</button>
        <button type="button" class="a-btn a-btn--sm" data-add="secao"><%- icon('section') %> Secção</button>
        <button type="button" class="a-btn a-btn--sm" data-add="texto"><%- icon('text') %> Nota</button>
      </div>
    </section>

    <section class="card" id="fotos">
      <div class="card__head"><h2>Fotografias da obra</h2><span class="small muted">JPEG/PNG · reduzidas automaticamente</span></div>
      <ul class="photo-grid" data-fotos>
        <% fotos.forEach((f) => { %>
        <li data-foto="<%= f.id %>">
          <a href="/media/<%= f.filename %>" target="_blank" rel="noopener"><img src="/media/<%= f.filename %>" alt="" loading="lazy"></a>
          <input class="photo-grid__cap" value="<%= f.legenda %>" placeholder="Legenda" maxlength="200" data-foto-legenda>
          <label class="photo-grid__pdf"><input type="checkbox" <%= f.no_pdf ? 'checked' : '' %> data-foto-pdf> No PDF</label>
          <button type="button" class="icon-btn icon-btn--danger" data-foto-apagar aria-label="Apagar fotografia"><%- icon('trash') %></button>
        </li>
        <% }) %>
      </ul>
      <label class="dropzone" data-fotos-drop>
        <input type="file" accept="image/*" multiple data-fotos-input>
        <%- icon('upload') %><span>Arraste fotografias ou clique para escolher</span>
      </label>
    </section>

    <section class="card">
      <div class="card__head"><h2>Texto do documento</h2></div>
      <label class="f"><span>Introdução</span><textarea name="introducao" rows="2"><%= orc.introducao %></textarea></label>
      <div class="grid-2">
        <label class="f"><span>Prazo de execução</span><textarea name="cond_prazo" rows="2"><%= orc.cond_prazo %></textarea></label>
        <label class="f"><span>Pagamento</span><textarea name="cond_pagamento" rows="2"><%= orc.cond_pagamento %></textarea></label>
        <label class="f"><span>Incluído</span><textarea name="cond_incluido" rows="2"><%= orc.cond_incluido %></textarea></label>
        <label class="f"><span>Não incluído</span><textarea name="cond_excluido" rows="2"><%= orc.cond_excluido %></textarea></label>
      </div>
      <label class="f"><span>Garantia</span><input name="cond_garantia" value="<%= orc.cond_garantia %>"></label>
      <label class="f"><span>Observações</span><textarea name="observacoes" rows="3"><%= orc.observacoes %></textarea></label>
      <label class="f"><span>Notas internas <small>(não aparecem no documento)</small></span><textarea name="notas_internas" rows="2"><%= orc.notas_internas %></textarea></label>
    </section>
  </div>

  <aside class="editor__side">
    <section class="card totals">
      <h2 class="card__title">Valores</h2>
      <dl class="totals__list">
        <div><dt>Subtotal</dt><dd data-t="subtotal"><%= u.eur(orc.subtotal) %></dd></div>
        <div class="totals__input"><dt><label for="desc">Desconto</label></dt><dd><span class="suffix"><input id="desc" name="desconto_pct" value="<%= u.num(orc.desconto_pct) %>" inputmode="decimal"><i>%</i></span> <span data-t="desconto_valor"><%= orc.desconto_valor ? '− ' + u.eur(orc.desconto_valor) : '' %></span></dd></div>
        <div class="totals__input"><dt><label for="iva">IVA</label></dt><dd>
          <select id="iva" name="iva_taxa">
            <% const cur = Number(orc.iva_taxa); const opts = ivaOpts.includes(cur) ? ivaOpts : [...ivaOpts, cur]; opts.forEach((t) => { %><option value="<%= t %>" <%= cur === t ? 'selected' : '' %>><%= t %>%</option><% }) %>
          </select> <span data-t="iva_valor"><%= u.eur(orc.iva_valor) %></span></dd></div>
        <div class="totals__total"><dt>Total</dt><dd data-t="total"><%= u.eur(orc.total) %></dd></div>
      </dl>
      <label class="f f--compact" data-iva-motivo <%= Number(orc.iva_taxa) === 0 || orc.iva_motivo ? '' : 'hidden' %>><span>Motivo (IVA 0% / menção)</span><input name="iva_motivo" value="<%= orc.iva_motivo %>" list="lista-iva" maxlength="300"></label>
      <label class="switch"><input type="checkbox" name="mostrar_precos_linha" value="1" <%= orc.mostrar_precos_linha ? 'checked' : '' %>><span></span>Mostrar preços por linha</label>
      <button class="a-btn a-btn--primary a-btn--block" type="submit" data-save><%- icon('check') %> Gravar</button>
      <p class="save-state" data-save-state aria-live="polite">Gravado</p>
    </section>

    <section class="card">
      <h2 class="card__title">Estado</h2>
      <div class="state-actions">
        <% [['rascunho', 'Rascunho'], ['enviado', 'Enviado'], ['aceite', 'Aceite'], ['recusado', 'Recusado']].forEach(([k, v]) => { %>
        <button type="submit" form="estado-form" name="estado" value="<%= k %>" class="state-btn estado--<%= k %>" <%= orc.estado === k ? 'aria-pressed=true disabled' : '' %>><%= v %></button>
        <% }) %>
      </div>
      <% if (orc.aceite_em) { %><p class="small muted mt-8">Aceite<%= orc.aceite_nome ? ' por ' + orc.aceite_nome : '' %> em <%= u.dataHoraPt(orc.aceite_em) %></p><% } %>
      <% if (orc.visto_em) { %><p class="small muted mt-8"><%- icon('eye', 'icon--sm inline') %> Aberto pelo cliente em <%= u.dataHoraPt(orc.visto_em) %></p><% } %>
      <% if (envios.length) { %>
      <h3 class="card__title mt-16">Envios</h3>
      <ul class="log">
        <% envios.slice(0, 6).forEach((e) => { %><li class="<%= e.ok ? '' : 'is-error' %>"><span><%= { whatsapp: 'WhatsApp', 'whatsapp-manual': 'WhatsApp (manual)', email: 'Email', link: 'Link copiado', 'aceite-online': 'Aceite online' }[e.canal] || e.canal %><%= e.destino ? ' · ' + e.destino : '' %></span><time><%= u.dataHoraPt(e.created_at) %></time><% if (!e.ok) { %><small><%= e.detalhe %></small><% } %></li><% }) %>
      </ul>
      <% } %>
    </section>

    <section class="card">
      <h2 class="card__title">Mais</h2>
      <div class="stack">
        <a class="a-btn a-btn--sm a-btn--block" href="/orcamentos/<%= orc.id %>/pdf?download=1" data-save-first><%- icon('download') %> Descarregar PDF</a>
        <button type="submit" form="duplicar-form" class="a-btn a-btn--sm a-btn--block"><%- icon('duplicate') %> Duplicar</button>
        <button type="submit" form="apagar-form" class="a-btn a-btn--sm a-btn--block a-btn--danger"><%- icon('trash') %> Apagar</button>
      </div>
    </section>
  </aside>
</form>
<form id="estado-form" method="post" action="/orcamentos/<%= orc.id %>/estado" data-save-before><input type="hidden" name="_csrf" value="<%= csrf %>"></form>
<form id="duplicar-form" method="post" action="/orcamentos/<%= orc.id %>/duplicar" data-save-before><input type="hidden" name="_csrf" value="<%= csrf %>"></form>
<form id="apagar-form" method="post" action="/orcamentos/<%= orc.id %>/apagar" data-confirm="Apagar o orçamento <%= orc.numero %>? Esta ação não pode ser desfeita."><input type="hidden" name="_csrf" value="<%= csrf %>"></form>
<datalist id="lista-series"><% listas.series.forEach((x) => { %><option value="<%= x %>"><% }) %></datalist>
<datalist id="lista-cores"><% listas.cores.forEach((x) => { %><option value="<%= x %>"><% }) %></datalist>
<datalist id="lista-vidros"><% listas.vidros.forEach((x) => { %><option value="<%= x %>"><% }) %></datalist>
<datalist id="lista-iva"><% listas.ivaMotivos.forEach((x) => { %><option value="<%= x %>"><% }) %></datalist>
<script type="application/json" id="orc-data"><%- json({ id: orc.id, linhas, artigos: artigos.map((a) => ({ id: a.id, nome: a.nome, tipo: a.tipo, categoria: a.categoria, descricao: a.descricao, unidade: a.unidade, preco: a.preco, area_minima: a.area_minima, desenho: a.desenho, largura: a.largura, altura: a.altura, serie: a.serie, imagem: a.imagem })), tipos }) %></script>
<%- include('../partials/bottom', { scripts: ['js/desenho.js', 'js/editor.js'] }) %>
